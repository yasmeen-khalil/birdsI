# Copy to .env.local for local runs. Production keys live only in Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Which deployment this is: app (default) or ops
APP_ROLE=app
# Dev allowlist for the ops deployment
DEV_USER_IDS=
# Cron routes refuse without it
CRON_SECRET=
# Inert until set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=
RESEND_API_KEY=
DEV_ALERT_EMAIL=
ONESIGNAL_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

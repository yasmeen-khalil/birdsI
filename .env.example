# birdsI environment. Copy to .env.local at the repository root; the web app
# reads it through the apps/web/.env.local symlink and the worker reads it
# directly. Never commit .env.local.

# Models. birdsI runs on Claude (ANTHROPIC_API_KEY) or on Nemotron through
# Nebius Token Factory (NEBIUS_API_KEY). With both set, Claude is used and
# Token Factory provides embeddings for chat. BIRDSI_PROVIDER=nebius forces Nemotron.
ANTHROPIC_API_KEY=
# Claude model overrides (defaults: nano claude-haiku-4-5, super claude-opus-5-5, ultra claude-fable-5-1)
# BIRDSI_PROVIDER=anthropic

# Nebius Token Factory (required for Nemotron; optional for embeddings and Sandboxes with Claude)
NEBIUS_API_KEY=
# Project id, needed for Sandboxes (fix testing). Optional; fixes skip testing without it.
NEBIUS_AI_PROJECT=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes/v1
# Model overrides (defaults are the current Nemotron 3 family)
# BIRDSI_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# BIRDSI_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# BIRDSI_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# BIRDSI_MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B

# Tavily (current docs). Optional; the docs check is skipped without it.
TAVILY_API_KEY=

# LangSmith tracing. Optional.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=birdsi

# Supabase (required)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Encrypts vendor account tokens the owner connects (any long random string, 32+ characters)
BIRDSI_SECRETS_KEY=

# Clerk (required for sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# GitHub App (required to connect repositories and open pull requests)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# The public URL of the web app, used in CLI sign-in and pull request links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limits (optional). Spend is in US dollars per rolling 24 hours across all users.
# BIRDSI_DAILY_SPEND_CAP_USD=5
# BIRDSI_DEMO_PER_CLIENT_PER_HOUR=3
# BIRDSI_DEMO_GLOBAL_PER_HOUR=30
# BIRDSI_USER_SCANS_PER_DAY=20
# BIRDSI_WORKER_POLL_MS=3000
# BIRDSI_DEMO_SAMPLE_PATH=samples/corner-bakery

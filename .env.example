# birdsI environment. Copy to .env.local at the repository root. The web app
# reads it through the apps/web/.env.local symlink and the worker reads it
# directly. Never commit .env.local.

# Supabase (required)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Encrypts the vendor keys the owner connects (any long random string, 32+ characters).
# Must be the same on the web app and the worker, and must never change once keys are stored.
BIRDSI_SECRETS_KEY=

# Clerk (required for sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# The docs check (optional): compares a main package's own current documentation
# with how the code imports it. It runs only when both keys are set.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# BIRDSI_MODEL_DOCS=claude-haiku-4-5

# GitHub App (optional): reads repositories without the terminal tool. Contents and Metadata read only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional. Arms the manual /api/cron/sync trigger (any long random string). The worker
# reads connected accounts by itself every hour.
CRON_SECRET=

# The public URL of the web app, used in CLI sign-in and links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alert emails (optional). With a Resend key, new alerts are emailed to the owner when email
# alerts are on in Settings. Without one, every alert says it was not emailed and why. Resend's
# shared sender delivers only to the address of the Resend account itself, which suits one
# operator. Set BIRDSI_ALERT_FROM to a sender on a domain verified in Resend to send elsewhere.
RESEND_API_KEY=
# BIRDSI_ALERT_FROM=birdsI <alerts@example.com>

# Limits (optional). Model spend is the docs check only, in US dollars per rolling 24 hours,
# across all users and per user. Reaching either stops the docs check, never a map.
# BIRDSI_DAILY_SPEND_CAP_USD=50
# BIRDSI_USER_DAILY_SPEND_CAP_USD=5
# BIRDSI_DEVICE_STARTS_PER_HOUR=20
# BIRDSI_USER_SCANS_PER_DAY=40
# BIRDSI_WORKER_POLL_MS=3000
# BIRDSI_DOCS_CONCURRENCY=4
# BIRDSI_DOCS_BUDGET_TOKENS=200000

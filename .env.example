# birdsI environment. Copy to .env.local at the repository root. The web app
# reads it through the apps/web/.env.local symlink, and npm run worker loads it
# with Node's --env-file. Never commit .env.local.

# Supabase (required)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Encrypts the vendor keys the owner connects (any long random string, 32+ characters).
# Must be the same on the web app and the worker, and must never change once keys are stored.
BIRDSI_SECRETS_KEY=

# Access by approval: the GitHub user ids (numbers, separated by commas) of the people who
# approve and deny requests, on the web app. Your own id is the number in
# https://api.github.com/users/<your login>. Without it nobody can approve a request.
BIRDSI_OWNER_GITHUB_IDS=

# Clerk (required for sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# The model (optional): Nemotron on Nebius Token Factory, or Claude through Anthropic.
# With NEBIUS_API_KEY set, Nemotron does the model work. With only ANTHROPIC_API_KEY, Claude does.
# BIRDSI_PROVIDER (nebius or anthropic) picks one when both keys are set. A model key alone turns on
# the model's reading of the code after the rules (numbered passages of the code, keys masked, go to
# that provider), the services' purposes and the explainer for a failed deployment. Without a model
# key the map runs by rules alone and says so.
NEBIUS_API_KEY=
ANTHROPIC_API_KEY=
# The docs check compares a main package's own current documentation with how the code
# imports it. It needs a model key and Tavily, which finds the documentation pages. On the worker,
# Tavily alone runs the weekly watch over the pricing pages, and a model key adds the large model's
# reading of a page that changed.
TAVILY_API_KEY=
# BIRDSI_PROVIDER=nebius
# The small model (the reading, the purposes, the docs check, the explainer) and the large one
# (the weekly pricing page watch), by id.
# BIRDSI_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# BIRDSI_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# The model's reading of the code after the rules: off with BIRDSI_READER=off. Its budget per map
# in input tokens, and how many passes run at once.
# BIRDSI_READER=on
# BIRDSI_READ_BUDGET_TOKENS=4000000
# BIRDSI_READ_CONCURRENCY=3

# GitHub App (optional): reads repositories without the terminal tool. Contents and Metadata read only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional. Arms the manual /api/cron/sync trigger (any long random string). The worker
# reads connected accounts by itself every hour.
CRON_SECRET=

# The public URL of the web app, used in CLI sign-in and links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A public demo (optional): the id of a mapped repository (from its address, /app/<id>) whose cockpit anyone
# can read at /demo, as the owner's own reads show it. Leave empty and /demo says no sample app is set up.
BIRDSI_DEMO_REPO_ID=

# Logos on the cockpit load from Simple Icons' address in the browser. Set off to show letter tiles only.
# NEXT_PUBLIC_BIRDSI_LOGOS=on

# Alert emails (optional). With a Resend key, new alerts are emailed to the owner when email
# alerts are on in Settings. Without one, every alert says it was not emailed and why. Resend's
# shared sender delivers only to the address of the Resend account itself, which suits one
# operator. Set BIRDSI_ALERT_FROM to a sender on a domain verified in Resend to send elsewhere.
RESEND_API_KEY=
# BIRDSI_ALERT_FROM=birdsI <alerts@example.com>

# Limits (optional). Model spend in US dollars per rolling 24 hours, across all users and per
# user. Every model call checks it first. Reaching either stops the model's part, never a map.
# BIRDSI_DAILY_SPEND_CAP_USD=50
# BIRDSI_USER_DAILY_SPEND_CAP_USD=5
# BIRDSI_DEVICE_STARTS_PER_HOUR=20
# BIRDSI_USER_SCANS_PER_DAY=40
# BIRDSI_WORKER_POLL_MS=3000
# BIRDSI_DOCS_CONCURRENCY=4
# BIRDSI_DOCS_BUDGET_TOKENS=200000
